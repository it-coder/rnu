{
  "default_server": "http://localhost:8081",
  "default_user": "admin",
  "repositories": {
    "npm": "npm-hosted",
    "maven": "maven-releases"
  },
  "profiles": {
    "local": {
      "server": "http://localhost:8081",
      "user": "admin",
      "repositories": {
        "npm": "npm-hosted",
        "maven": "maven-releases"
      }
    },
    "development": {
      "server": "http://dev-nexus.company.com:8081",
      "user": "dev-user",
      "repositories": {
        "npm": "npm-hosted",
        "maven": "maven-releases"
      }
    },
    "staging": {
      "server": "https://staging-nexus.company.com",
      "user": "staging-deploy",
      "repositories": {
        "npm": "npm-private",
        "maven": "maven-releases"
      }
    },
    "production": {
      "server": "https://nexus.company.com",
      "user": "prod-deploy",
      "repositories": {
        "npm": "npm-private",
        "maven": "maven-releases"
      }
    }
  }
}
